# Copy to .env and set SECRET_KEY before starting the API.

APP_NAME=Softus Checkin
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# REQUIRED — the app refuses to start without it.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
INVITE_EXPIRE_HOURS=72
PASSWORD_RESET_EXPIRE_MINUTES=60

MONGO_URI=mongodb://localhost:27017
MONGO_DB=softus_checkin

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Organisation timezone — attendance dates are derived in this zone.
ORG_TIMEZONE=Asia/Kolkata

# Public URL of the React app, used to build invite / reset links in emails.
FRONTEND_URL=http://localhost:5173

# console = print emails to stdout (development). smtp = actually send.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@softus.local
EMAIL_FROM_NAME=Softus Checkin
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
