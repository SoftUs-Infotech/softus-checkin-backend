# Copy to .env and set SECRET_KEY before starting the API.

APP_NAME=Softus Checkin
# development | production. Production hides /docs, refuses the demo seeder and
# checks FRONTEND_URL / CORS_ORIGINS at start-up. See deploy/.env.production.example.
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# REQUIRED — the app refuses to start without it.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
INVITE_EXPIRE_HOURS=72
PASSWORD_RESET_EXPIRE_MINUTES=60

MONGO_URI=mongodb://localhost:27017
MONGO_DB=softus_checkin

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional pattern for origins that cannot be listed, e.g. Vercel previews on a
# staging API. Pin it to your team scope; refused when ENVIRONMENT=production.
CORS_ORIGIN_REGEX=

# Organisation timezone — attendance dates are derived in this zone.
ORG_TIMEZONE=Asia/Kolkata

# Public URL of the React app, used to build invite / reset links in emails.
FRONTEND_URL=http://localhost:5173

# console = print emails to stdout (development). smtp = actually send.
# Which upstream hops may be believed about who the caller is. Comma-separated
# addresses or CIDR ranges; empty trusts nothing and the socket's own peer
# address is always used.
#
# `X-Forwarded-For` is a header, so it is whatever the sender typed. It is read
# only when the machine that opened the connection is listed here, and then from
# the right — a proxy appends the peer it saw, so only the right-hand entries
# were written by infrastructure. Get this wrong and the office-network rule can
# be defeated with one `curl -H`.
#
# Loopback is the default because the API only sees loopback when something on
# the same host forwarded the request. Behind a proxy on another host, add that
# host. Behind one that does NOT strip an inbound X-Forwarded-For, the rule
# cannot be enforced at all.
TRUSTED_PROXIES=127.0.0.1,::1

EMAIL_PROVIDER=console

# Optional. Sets which provider names the place a punch came from. With a key,
# Google answers; without one the lookup falls back to OpenStreetMap's
# Nominatim, which needs no key and is what the register's city column shows by
# default. Either way the answer is cached for 30 days per location, and a
# failure never fails a punch.
GOOGLE_MAPS_API_KEY=
EMAIL_FROM=no-reply@softus.local
EMAIL_FROM_NAME=Softus Checkin
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
