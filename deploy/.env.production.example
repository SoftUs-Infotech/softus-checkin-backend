# Production settings for the API, Caddy and (optionally) MongoDB.
# Copy to .env.production on the server and fill in every value marked REQUIRED.
# Never commit the filled-in copy — .gitignore and .dockerignore both exclude it.

# --- Domain and HTTPS (Caddy) -------------------------------------------------
# REQUIRED. The API's own hostname. Point a DNS A record at the instance's
# Elastic IP *before* starting, or Let's Encrypt cannot issue the certificate.
API_DOMAIN=api.example.com
# REQUIRED. Where Let's Encrypt sends certificate-expiry notices.
ACME_EMAIL=ops@example.com

# --- Application ---------------------------------------------------------------
APP_NAME=Softus Checkin
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1
ORG_TIMEZONE=Asia/Kolkata

# REQUIRED. At least 32 characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everybody out.
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
INVITE_EXPIRE_HOURS=72
PASSWORD_RESET_EXPIRE_MINUTES=60

# --- Web app (Vercel) ----------------------------------------------------------
# REQUIRED. The public address of the web app — invite and password-reset links
# in emails are built from it. https:// only; the API will not start otherwise.
FRONTEND_URL=https://checkin.example.com
# REQUIRED. Every origin the web app is served from, comma-separated: the
# custom domain and the project's production *.vercel.app address. Exact
# addresses only — CORS_ORIGIN_REGEX is refused in production; give preview
# deployments their own staging API instead.
CORS_ORIGINS=https://checkin.example.com,https://softus-checkin.vercel.app

# --- Database ------------------------------------------------------------------
# REQUIRED. MongoDB Atlas connection string (Database > Connect > Drivers).
# In Atlas > Network Access, allow this instance's Elastic IP only.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=softus_checkin

# Only with `--profile local-mongo` (MongoDB on this instance instead of Atlas).
# Then set MONGO_URI=mongodb://softus:<password>@mongo:27017/?authSource=admin
MONGO_INITDB_ROOT_USERNAME=softus
MONGO_INITDB_ROOT_PASSWORD=

# --- Email ---------------------------------------------------------------------
# smtp sends real mail. Use console on any server that is not production.
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Softus Checkin
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# --- Optional ------------------------------------------------------------------
# Better place names on punches. Without it OpenStreetMap is used.
GOOGLE_MAPS_API_KEY=
